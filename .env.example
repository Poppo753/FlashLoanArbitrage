# Environment for the Solidity side. The TypeScript bot has its own template in bot/.env.example.
#
# Copy to `.env` (gitignored) and fill in. Never commit the filled file.

# --- Deployer ---
# Only needed for a real broadcast; the fork and mock tests do not read it.
PRIVATE_KEY=your_private_key_here

# --- Arbitrum One RPC ---
# Used by `forge script --rpc-url arbitrum` and by the fork tests
# (`forge test --fork-url arbitrum --fork-block-number 509000000`).
# Public fallback, no key: https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# --- Arbitrum One addresses ---
# The cycle borrows and closes in the base token, using the quote token as the
# intermediate. Venue A is a Uniswap V2 compatible router, venue B a Uniswap V3
# SwapRouter. The defaults below are the official Arbitrum One deployments; the
# deploy script has them baked in, so set these only to target something else.
# BASE_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831   # USDC, 6 decimals
# QUOTE_TOKEN_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1  # WETH, 18 decimals
# VENUE_A_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24     # Uniswap V2 Router02
# VENUE_B_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564     # Uniswap V3 SwapRouter

# --- Plugin parameters ---
# Minimum acceptable profit of a cycle, in base token wei (1 USDC = 1e6). The
# contract defaults to 0, which accepts any non-negative outcome: set this.
MIN_PROFIT=1000000
# Slippage budget per leg, in basis points. Capped at 2000 by the constructor.
MAX_SLIPPAGE_BPS=50
# Seconds a route stays valid. Must be between 30 and 3600.
DEADLINE_WINDOW=60

# --- Verification ---
# ARBISCAN_API_KEY=your_arbiscan_api_key
