# ============================================================================
# Flash Loan Arbitrage Bot - Arbitrum One
# ============================================================================
# The active chain is Arbitrum One (chainId 42161). On-chain the strategy is a
# Balancer V2 (0% fee) funded, Uniswap V2 <-> V3 arbitrage driven by
# contracts/ArbitragePlugin.sol + contracts/services/FlashLoanService.sol.
#
# There is no Ethereum and no Aave deployment behind this bot any more: the
# ETHEREUM_* and BASE_* blocks and the *_AAVE_* variables are gone on purpose.
#
# Copy this file to `.env` (gitignored) and fill in the RPC endpoints.
# ============================================================================

# --- Arbitrum One RPC -------------------------------------------------------
# Both endpoints point at Arbitrum mainnet and are SEPARATE on purpose:
#   ARBITRUM_RPC_URL      https://  - JSON-RPC, used by Simulator/ExecutionEngine
#   ARBITRUM_WS_RPC_URL   wss://    - WebSocket, used by PoolMonitor (pair Sync events)
# A wss:// URL is mandatory for PoolMonitor; an https:// URL there is rejected.
#
# Recommended: a keyed Alchemy Arbitrum endpoint (e.g.
# https://arb-mainnet.g.alchemy.com/v2/<KEY> and its wss:// twin).
# Public fallback (no key, rate limited, fine for a first run):
#   https://arb1.arbitrum.io/rpc
# Public endpoints usually do NOT serve wss://; for the WebSocket half you need
# a keyed provider (Alchemy/Infura) or run your own Arbitrum node.
# No URL or API key is hardcoded in the bot: these two variables are the only
# source of endpoints.
ARBITRUM_NAME=Arbitrum One
ARBITRUM_CHAIN_ID=42161
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ARBITRUM_WS_RPC_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# --- Tokens (Arbitrum One) --------------------------------------------------
# Base token: native USDC on Arbitrum, 6 decimals. This is the asset the cycle
# borrows and closes in (baseToken of ArbitragePlugin).
ARBITRUM_BASE_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Quote token: WETH on Arbitrum, 18 decimals (quoteToken of ArbitragePlugin).
ARBITRUM_WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1

# --- Uniswap V2 on Arbitrum (official Uniswap deployment) -------------------
# Factory: used by PoolMonitor to resolve the pairs to subscribe to.
ARBITRUM_UNISWAP_V2_FACTORY=0xf1D7CC64Fb4452F05c498126312eBE29f30Fbcf9
# Router02: venue A of ArbitragePlugin.
ARBITRUM_UNISWAP_V2_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24

# --- Flash loan source: Balancer V2 Vault -----------------------------------
# The 0%-fee flash loan source used by contracts/services/FlashLoanService.sol.
ARBITRUM_BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

ARBITRUM_BLOCK_EXPLORER=https://arbiscan.io
# Per-chain override of the flash loan premium; see the global note below.
ARBITRUM_FLASH_LOAN_PREMIUM_BPS=0

# --- Detection universe -----------------------------------------------------
# Comma-separated Arbitrum token addresses to monitor pairs for, on the active
# chain. Default: WETH + USDC. WETH is always monitored (it is the chain's
# quote token), so listing it again is harmless - it is de-duplicated.
# Only Uniswap V2 pairs are monitored; the deep V3 0.05% pool is out of scope.
MONITOR_TOKENS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1,0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# --- Bot Configuration ------------------------------------------------------
BOT_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
MIN_PROFIT_WEI=0
MIN_PROFIT_USD=10
MAX_GAS_PRICE_GWEI=100
MAX_SLIPPAGE_BPS=50
MIN_LOOP_PROFIT_MARGIN=0.05
GAS_LIMIT=3000000
PRIORITY_FEE_WEI=2000000000
BASE_FEE_MULTIPLIER=1.1

# Flash loan premium charged on the borrowed amount, in basis points.
# Balancer V2 flash loans are FREE (0 bps) - the old 5 bps figure was the Aave
# default and no longer applies. Raise it only if a fee-bearing source is
# substituted for the Balancer Vault.
FLASH_LOAN_PREMIUM_BPS=0

# --- External Services ------------------------------------------------------
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/flashloan
SIMULATION_BLOCK_DELAY=1
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# --- MEV / Flashbots --------------------------------------------------------
# NOTE: private-order flow and bundle submission are NOT wired to
# ArbitragePlugin.startArbitrage yet (open audit item B6); the flags below only
# affect the existing Flashbots module.
USE_FLASHBOTS=true
FLASHBOTS_URL=https://relay.flashbots.net
FLASHBOTS_PROTECT_URL=https://flashbots.net/flashbots-protected
# Optional global WebSocket override used by mevMonitor (else ARBITRUM_WS_RPC_URL)
WS_RPC_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
